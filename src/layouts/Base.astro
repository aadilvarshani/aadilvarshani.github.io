---
import { CSP } from "../site";

interface Props {
  title: string;
  description: string;
  bodyClass: string;
  base?: string;
  canonical?: string;
  publishedTime?: string;
  scripts?: string[];
}

const { title, description, bodyClass, base = "", canonical, publishedTime, scripts = [] } = Astro.props;
---
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta http-equiv="Content-Security-Policy" content={CSP}>
<meta name="referrer" content="no-referrer">
<title set:html={title} />
<meta name="description" content={description}>
{canonical && <link rel="canonical" href={canonical}>}
{publishedTime && <meta property="article:published_time" content={publishedTime}>}
<link rel="icon" type="image/svg+xml" href={`${base}assets/favicon.svg`}>
<link rel="apple-touch-icon" href={`${base}assets/apple-touch-icon.png`}>
<link rel="preload" href={`${base}assets/fonts/bricolage-grotesque-latin-opsz.woff2`} as="font" type="font/woff2" crossorigin>
<link rel="preload" href={`${base}assets/fonts/ibm-plex-mono-latin-400.woff2`} as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href={`${base}css/site.css`}>
<script is:inline src={`${base}js/theme-init.js`}></script>
</head>
<body class={bodyClass}>

<header class="site-bar">
  <a class="site-bar__name" href={`${base}index.html`}>Aadil Varshani</a>
  <nav class="site-bar__nav" aria-label="Main">
    <a href={`${base}blog/index.html`}>Writing</a>
    <a href={`${base}contact.html`}>Contact</a>
    <a href="https://github.com/aadilvarshani" target="_blank" rel="noopener noreferrer">GitHub</a>
    <a href="https://linkedin.com/in/aadil-varshani" target="_blank" rel="noopener noreferrer">LinkedIn</a>
    <button class="theme-toggle" type="button" data-theme-toggle hidden>Dark</button>
  </nav>
</header>

<main>
<slot />
</main>

<script is:inline src={`${base}js/theme-toggle.js`} defer></script>
{scripts.map((name) => <script is:inline src={`${base}js/${name}`} defer></script>)}
</body>
</html>
